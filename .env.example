# ============================================
# Desafio de Travesias - Environment Variables
# ============================================

# Application
APP_NAME=DesafioDeTravesias
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=change-me-to-a-random-string
BACKEND_PORT=8000

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/travesias_db
DATABASE_URL_SYNC=postgresql://postgres:password@localhost:5432/travesias_db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# YouTube Data API v3
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# DeepSeek AI
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Email (SendGrid)
SENDGRID_API_KEY=
FROM_EMAIL=noreply@pasionextrema.org

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Cloud Messaging
FCM_SERVER_KEY=

# Sentry
SENTRY_DSN=

# Frontend
FRONTEND_URL=http://localhost:5173
